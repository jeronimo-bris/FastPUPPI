universe = vanilla

executable = $(script_dir)/run_cmssw_stage.sh
arguments = runInputs151X_htcondor.py $(input_file) $(output_name) $(max_events) $(cmssw_dir) $(output_path) $(stageout_mode)

should_transfer_files = YES
when_to_transfer_output = ON_SUCCESS
success_exit_code = 0

transfer_input_files = $(cmssw_dir)/src/FastPUPPI/NtupleProducer/python/runInputs151X_htcondor.py
transfer_output_files = $(condor_output_files)
transfer_output_remaps = "$(condor_output_remaps)"
use_x509userproxy = $(use_x509userproxy)

output = $(stdout)
error = $(stderr)
log = $(joblog)

request_cpus = 4
request_memory = 8GB
request_disk = 10GB

requirements = (Machine =!= "hd91.dice.priv")

queue